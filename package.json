{
  "name": "excel-collab",
  "version": "0.1.13-fork.8",
  "description": "Online Collaboration Excel",
  "author": "Steve Xu <stevexugc@gmail.com>",
  "bugs": "https://github.com/nusr/excel/issues",
  "homepage": "https://github.com/nusr/excel",
  "repository": "git+https://github.com/nusr/excel.git",
  "license": "MIT",
  "module": "./lib/index.es.js",
  "main": "./lib/index.umd.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.es.js",
      "module": "./lib/index.es.js",
      "require": "./lib/index.umd.js"
    },
    "./style.css": "./lib/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "type-check": "tsc",
    "build": "vite build",
    "test": "jest --forceExit --detectOpenHandles",
    "test:ci": "JEST_JUNIT_CLASSNAME=\"{filepath}\" jest --reporters=jest-junit --forceExit --detectOpenHandles"
  },
  "dependencies": {
    "@formulajs/formulajs": "^4.5.5",
    "chart.js": "^4.5.1",
    "comlink": "^4.4.2",
    "jszip": "^3.10.1",
    "numfmt": "^3.2.3",
    "uuid": "^13.0.0",
    "y-protocols": "^1.0.7",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "canvas": "^3.2.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-junit": "^16.0.0",
    "pngjs": "^7.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-dts": "^4.5.4",
    "yjs": "^13.6.30"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "yjs": "^13.6.30"
  },
  "peerDependenciesMeta": {
    "yjs": {
      "optional": false
    }
  },
  "keywords": [
    "react",
    "yjs",
    "collaboration",
    "excel",
    "xlsx",
    "spreadsheet"
  ],
  "files": [
    "lib",
    "CHANGELOG.md",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  }
